# Copy file này thành .env rồi điền giá trị thật — KHÔNG commit file .env lên git

PORT=3000

# Chuỗi bí mật để mã hoá session cookie — đặt 1 chuỗi ngẫu nhiên dài, giữ kín
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# Đường dẫn tới file JSON key của Google Service Account
# (Tạo tại: Google Cloud Console > IAM & Admin > Service Accounts > Keys > Add Key > JSON)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# ID của Google Sheet HanhPhuc99 — lấy từ URL:
# docs.google.com/spreadsheets/d/[ID_NAY]/edit
SHEET_ID=

# ── MinIO (S3-compatible) — kho ảnh, thay cho Google Drive ───────────────────
# Endpoint của MinIO chạy trên Zima NAS. Nếu Node chạy trong Docker cùng network với
# MinIO thì dùng http://minio:9000 (KHÔNG dùng localhost). Node chạy ngoài Docker
# thì dùng IP của Zima.
MINIO_ENDPOINT=http://192.168.123.125:9010
# Region chỉ là giá trị ký kết S3-compatible — MinIO mặc định us-east-1,
# KHÔNG có nghĩa là server nằm ở Mỹ.
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Tất cả ảnh nằm trong 1 bucket duy nhất, tổ chức theo orders/{ma-don}/...
MINIO_BUCKET=orders
MINIO_FORCE_PATH_STYLE=true
# Thời hạn (giây) của presigned URL khi cần chia sẻ ảnh tạm ngoài proxy API
MINIO_PRESIGNED_URL_EXPIRES=3600

# ── Cảnh báo Telegram (3 tầng: Vàng/Cam/Đỏ + nhắc ship) ──────────────────────
# Tạo bot qua @BotFather, lấy token; lấy chat_id bằng cách thêm bot vào group rồi gọi
# https://api.telegram.org/bot<TOKEN>/getUpdates để xem chat_id của group đó.
# Có thể trỏ cả 4 biến dưới về cùng 1 group nếu chưa muốn tách nhóm riêng.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHATID_VANG=
TELEGRAM_CHATID_CAM=
TELEGRAM_CHATID_DO=
TELEGRAM_CHATID_DONGGOI=

# ── Chatbot (LLM nội bộ, OpenAI-compatible) ──────────────────────────────────
LLM_API_URL=https://llm.wokushop.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
# Tuỳ chọn — model mạnh hơn dùng khi câu hỏi có từ khoá phân tích/tổng hợp/so sánh. Để trống nếu chỉ dùng 1 model.
LLM_MODEL_MANH=

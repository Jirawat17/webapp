# Copy file này thành .env rồi điền giá trị thật — KHÔNG commit file .env lên git

PORT=3000

# Chuỗi bí mật để mã hoá session cookie — đặt 1 chuỗi ngẫu nhiên dài, giữ kín
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# Đường dẫn tới file JSON key của Google Service Account
# (Tạo tại: Google Cloud Console > IAM & Admin > Service Accounts > Keys > Add Key > JSON)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# ID của Google Sheet HanhPhuc99 — lấy từ URL:
# docs.google.com/spreadsheets/d/[ID_NAY]/edit
SHEET_ID=

# ID của thư mục Google Drive gốc để chứa ảnh — lấy từ URL:
# drive.google.com/drive/folders/[ID_NAY]
DRIVE_ROOT_FOLDER_ID=

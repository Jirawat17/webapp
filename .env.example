# Copy file này thành .env rồi điền giá trị thật — KHÔNG commit file .env lên git

PORT=3000

# Chuỗi bí mật để mã hoá session cookie — đặt 1 chuỗi ngẫu nhiên dài, giữ kín
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# Tên miền app (qua Cloudflare) cho máy chủ tự đo mạng mỗi phút (services/doMangMayChuService.js), vd xuong.example.com — chỉ tên miền,
# không https://. Bỏ trống: tự lấy từ lượt truy cập đầu tiên đi qua Cloudflare.
TEN_MIEN_APP=
# 2 đích tham chiếu KHÔNG qua Cloudflare cho phép đo mỗi phút (host:cổng, chỉ mở kết nối TCP rồi đóng — không gửi dữ liệu).
# Bỏ trống = mặc định vnexpress.net:443 (trong nước) và proof.ovh.net:80 (quốc tế — máy chủ thử tốc độ OVH ở Pháp).
DO_MANG_DICH_TRONG_NUOC=
DO_MANG_DICH_QUOC_TE=
# Nhà mạng của người dùng trong log đo mạng (services/nhaMangService.js): máy chủ tự tải file IP -> nhà mạng (iptoasn.com) mỗi tuần vào
# data/nha_mang_vn.json, chỉ giữ dải IP Việt Nam, KHÔNG lưu IP người dùng. Thường để trống; chỉ đặt khi muốn đổi nguồn tải.
IP2ASN_URL=
# Máy chủ tự đo tốc độ đường mạng (tải xuống + tải lên 1MB tới speed.cloudflare.com, ~200MB/ngày) mỗi N phút — bỏ trống = 15, 0 = tắt.
DO_TOC_DO_PHUT=

# Đường dẫn tới file JSON key của Google Service Account
# (Tạo tại: Google Cloud Console > IAM & Admin > Service Accounts > Keys > Add Key > JSON)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# ID của Google Sheet HanhPhuc99 — lấy từ URL:
# docs.google.com/spreadsheets/d/[ID_NAY]/edit
SHEET_ID=

# ── MinIO (S3-compatible) — kho ảnh, thay cho Google Drive ───────────────────
# Endpoint của MinIO chạy trên Zima NAS. Nếu Node chạy trong Docker cùng network với
# MinIO thì dùng http://minio:9000 (KHÔNG dùng localhost). Node chạy ngoài Docker
# thì dùng IP của Zima.
MINIO_ENDPOINT=http://192.168.123.125:9010
# Region chỉ là giá trị ký kết S3-compatible — MinIO mặc định us-east-1,
# KHÔNG có nghĩa là server nằm ở Mỹ.
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Tất cả ảnh nằm trong 1 bucket duy nhất, tổ chức theo orders/{ma-don}/...
MINIO_BUCKET=orders
MINIO_FORCE_PATH_STYLE=true
# Thời hạn (giây) của presigned URL khi cần chia sẻ ảnh tạm ngoài proxy API
MINIO_PRESIGNED_URL_EXPIRES=3600

# ── Telegram ─────────────────────────────────────────────────────────────────
# Tạo bot qua @BotFather, lấy token; lấy chat_id bằng cách thêm bot vào group rồi gọi
# https://api.telegram.org/bot<TOKEN>/getUpdates để xem chat_id của group đó.
# (16/10/2026: bỏ gửi Telegram cảnh báo 3 tầng Vàng/Cam/Đỏ — các biến TELEGRAM_CHATID_VANG/CAM/DO/DONGGOI không còn dùng.)
TELEGRAM_BOT_TOKEN=
# Báo lỗi khi CRON TỰ ĐỘNG mua tracking GKE xong nhưng đẩy sang Sheet khách hàng thất bại (bổ sung
# 21/09/2026 — xem services/customerSheetService.js). CHỈ báo khi lỗi, không báo khi thành công.
TELEGRAM_CHATID_TRACKING_KH=

# ── Chatbot (LLM nội bộ, OpenAI-compatible) ──────────────────────────────────
LLM_API_URL=https://llm.wokushop.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
# Tuỳ chọn — model mạnh hơn dùng khi câu hỏi có từ khoá phân tích/tổng hợp/so sánh. Để trống nếu chỉ dùng 1 model.
LLM_MODEL_MANH=

# ── Trích ảnh từ trang chia sẻ dựng bằng JS (vd link chia sẻ chat Gemini) ────
# Đường dẫn tới Chromium/Chrome đã cài trên máy — dùng chung cho mọi trang JS cần trình duyệt ảo mới
# đọc được ảnh (xem services/trangWebService.js). Trên Docker (Dockerfile) đã tự set sẵn, KHÔNG cần
# khai báo lại. Chỉ cần điền khi chạy trực tiếp trên máy dev (không qua Docker) và muốn test luồng
# này — trỏ tới Chrome/Edge cài sẵn, vd Windows: C:/Program Files/Google/Chrome/Application/chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# ── GKE Logistics (tạo vận đơn + in tem tự động khi "Đã sản xuất") ──────────
# Tài khoản API — xin từ đội vận hành GKE, KHÔNG dùng chung với tài khoản đăng nhập web GKE thường.
GKE_API_USERNAME=
GKE_API_PASSWORD=
# Mã dịch vụ vận chuyển — lấy bằng cách gọi GET auth/login/ lấy token rồi gọi
# GET https://order.gkelogistics.com/openapi/customer/get/services/ (kèm header Authorization: Bearer <token>)
# để xem danh sách mã dịch vụ tài khoản bạn được dùng, chọn đúng mã ứng với thị trường đang giao (vd Mỹ).
GKE_SERVICE_CODE=
# Thông tin người gửi (xưởng) — GKE bắt buộc phải có đủ các trường dưới đây cho mỗi đơn tạo mới.
GKE_SHIPPER_NAME=Maxthread VN
GKE_SHIPPER_PHONE=
GKE_SHIPPER_ADDRESS=
GKE_SHIPPER_CITY=Hà Nội
GKE_SHIPPER_PROVINCE=Hà Nội
GKE_SHIPPER_POSTCODE=100000
# Khai báo hải quan — dùng 1 mức cố định cho mọi đơn (theo quyết định 31/08/2026). Sửa lại nếu cần
# chính xác hơn theo từng loại sản phẩm sau này.
GKE_CUSTOMS_ITEM_NAME=Embroidered garment
GKE_CUSTOMS_HS_CODE=
GKE_CUSTOMS_DECLARED_PRICE=
GKE_CUSTOMS_CURRENCY=USD

# Mật khẩu xác nhận khi lưu / mở tạm "Giờ nghỉ theo Xưởng" (Settings, services/gioTruyCapService.js). Bỏ trống = không lưu được.
MAT_KHAU_GIO_NGHI=

# Mật khẩu xác nhận khi XOÁ / KHÔI PHỤC dữ liệu đơn hàng (routes/orders.js, CHỈ superadmin). Bỏ trống = không thao tác được.
MAT_KHAU_DU_LIEU_DON=
